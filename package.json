{
  "name": "jolts-publisher-packages",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "packages/agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sdk:build": "tsc --project packages/sdk/tsconfig.json",
    "sdk:test": "npm run sdk:build && node --test packages/sdk/test/*.test.mjs",
    "agent:build": "tsc --project packages/agent/tsconfig.json",
    "agent:test": "npm run agent:build && node --test packages/agent/test/*.test.mjs",
    "build": "npm run sdk:build && npm run agent:build",
    "test": "npm run sdk:test && npm run agent:test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ci": "npm run lint && npm test && npm audit --audit-level=high"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.19.2",
    "@biomejs/biome": "2.6.2"
  }
}
